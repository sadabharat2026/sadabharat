# Paste inside the nginx `server { ... }` block that serves sadabharatayurvedic.com,
# ABOVE the existing `location / { ... }` block.
#
# Link-preview bots (WhatsApp, Facebook, Telegram, etc.) get the per-product Open
# Graph page from the backend (/api/og/product/:id) so the product photo shows
# instead of the logo. Normal visitors still get the SPA.
#
# Then: sudo nginx -t && sudo systemctl reload nginx

location ~ ^/product/([a-fA-F0-9]{24})/?$ {
    if ($http_user_agent ~* "(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|pinterest|skypeuripreview)") {
        rewrite ^/product/([a-fA-F0-9]{24})/?$ /api/og/product/$1 last;
    }
    try_files $uri /index.html;
}
